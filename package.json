{
  "name": "tup-smart-gym",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lighthouse": "lhci autorun --collect.url=http://localhost:4200 --collect.numberOfRuns=1",
    "esbuild-visualizer": "ng build --stats-json && esbuild-visualizer --metadata ./dist/tup-smart-gym/stats.json --filename ./reports/bundle-report.html"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.9",
    "@auth0/auth0-angular": "^2.9.0",
    "@lhci/cli": "^0.15.1",
    "@sentry/angular": "^10.69.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "esbuild-visualizer": "^0.7.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
